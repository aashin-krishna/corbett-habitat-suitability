# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Large Geospatial Datasets
# Raw remote sensing and LULC raster files (which exceed GitHub's 100MB file limit)
*.tif
*.tiff
*.zip
*.SAFE/
*.jp2

# Exception: Allow shapefiles for AOI (Jim Corbett boundary is small and useful)
# We place this boundary in data/raw/AOI/ which we want to track.
!data/raw/AOI/*

# Ignore local output logs and temp test data
data/processed/**/*.tif
data/processed/**/*.tiff
data/processed/**/*.zip
data/processed/**/*.csv
!data/processed/**/.gitkeep
!data/raw/**/.gitkeep
